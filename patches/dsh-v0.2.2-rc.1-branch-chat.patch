@@ -0,0 +1,154 @@
+/** Floating branch windows for the selected main conversation. */
+import { useMemo, useRef, useState } from 'react'
+import type { SessionReference } from '@deepseek-ai/dsh-api-session-controller/client'
+import { IconThinkOutlineRegular, MarkdownText, TextShimmer, reasoningPreview, reasoningText, type MarkdownLabels } from '@deepseek-ai/dsh-client-ui-primitives'
+import type { HostObservable, InjectFace, PropsLocale, PropsRenderSlots, PropsRuntime } from '@deepseek-ai/dsh-client-ui-slots'
+import type { BranchAnchor, BranchWindow } from './branch-chat.ts'
+import { normalizeBranchMath } from './branch-math.ts'
+import type { NS } from './locales.ts'
+import css from './BranchChatOverlay.module.css'
+
+/** Callbacks and live windows provided by the branch controller. */
+export interface BranchOverlayInjected {
+  hooks: { branches: HostObservable<readonly BranchWindow[]> }
+  sendBranch: (id: string, question: string) => Promise<void>
+  moveBranch: (id: string, anchor: BranchAnchor) => void
+  removeBranch: (id: string) => void
+  referenceFor: (id: string) => SessionReference | undefined
+}
+
+/** Root overlay props, independent of the selection toolbar's lifetime. */
+export type BranchOverlayProps = PropsRuntime<'shell.overlay'> & PropsRenderSlots<'branch.chat.model'>
+  & PropsLocale<typeof NS> & InjectFace<BranchOverlayInjected>
+
+/**
+ * Show only windows attached to the current main conversation.
+ * @param props - current session, branch controller, and locale bindings.
+ * @returns draggable branch windows or nothing.
+ */
+export function BranchChatOverlay({ useSessions, useBranches, sendBranch, moveBranch, removeBranch, referenceFor, renderSlot, SessionProvider, t }: BranchOverlayProps) {
+  const currentId = useSessions(state => Object.values(state.byId)
+    .find(row => (row.retainedBy.mainView ?? 0) > 0)?.id)
+  const branches = useBranches(rows => rows)
+  if (currentId === undefined) return null
+  return <>{branches.filter(row => row.parentId === currentId).map(row => (
+    <BranchCard key={row.id} branch={row} reference={referenceFor(row.id)}
+      renderSlot={renderSlot} SessionProvider={SessionProvider}
+      send={sendBranch} move={moveBranch} remove={removeBranch} t={t} />
+  ))}</>
+}
+
+/** One window keeps its unsent draft and drag gesture local to this mount. */
+function BranchCard({ branch, reference, renderSlot, SessionProvider, send, move, remove, t }: {
+  branch: BranchWindow
+  reference: SessionReference | undefined
+  renderSlot: BranchOverlayProps['renderSlot']
+  SessionProvider: BranchOverlayProps['SessionProvider']
+  send: BranchOverlayInjected['sendBranch']
+  move: BranchOverlayInjected['moveBranch']
+  remove: BranchOverlayInjected['removeBranch']
+  t: BranchOverlayProps['t']
+}) {
+  const [draft, setDraft] = useState('')
+  const labels = useMemo<MarkdownLabels>(() => ({
+    code: {
+      copyLabel: t('branch.copy'), copiedLabel: t('branch.copied'),
+      toolbarLabels: { codeLabel: t('branch.code'), wrapLabel: t('branch.wrap'), unwrapLabel: t('branch.unwrap') },
+    },
+    footnotes: t('branch.footnotes'),
+  }), [t])
+  const [position, setPosition] = useState<BranchAnchor>({ x: branch.x, y: branch.y })
+  const positionRef = useRef(position)
+  const drag = useRef<{ pointerId: number; x: number; y: number; left: number; top: number } | null>(null)
+  const submit = (): void => {
+    const text = draft.trim()
+    if (text === '' || branch.loading || branch.running || branch.error !== null || branch.childId === undefined) return
+    setDraft('')
+    void send(branch.id, text)
+  }
+  const onPointerDown = (event: React.PointerEvent<HTMLDivElement>): void => {
+    if (event.button !== 0 || event.target instanceof Element && event.target.closest('button')) return
+    event.currentTarget.setPointerCapture(event.pointerId)
+    drag.current = { pointerId: event.pointerId, x: event.clientX, y: event.clientY, left: position.x, top: position.y }
+  }
+  const onPointerMove = (event: React.PointerEvent<HTMLDivElement>): void => {
+    const start = drag.current
+    if (start?.pointerId !== event.pointerId) return
+    const card = event.currentTarget.parentElement?.getBoundingClientRect()
+    const next = {
+      x: Math.max(8, Math.min(start.left + event.clientX - start.x, window.innerWidth - (card?.width ?? 80) - 8)),
+      y: Math.max(8, Math.min(start.top + event.clientY - start.y, window.innerHeight - (card?.height ?? 55) - 8)),
+    }
+    positionRef.current = next
+    setPosition(next)
+  }
+  const onPointerEnd = (event: React.PointerEvent<HTMLDivElement>): void => {
+    if (drag.current?.pointerId !== event.pointerId) return
+    drag.current = null
+    move(branch.id, positionRef.current)
+  }
+  const hasLiveOutput = branch.messages.some(message => message.live === true)
+  const showWaiting = branch.running && !branch.loading && !hasLiveOutput
+    && branch.messages.at(-1)?.role !== 'assistant'
+  return <section className={css.card} style={{ left: position.x, top: position.y }} aria-label={t('branch.title')}>
+    <div className={css.header} onPointerDown={onPointerDown} onPointerMove={onPointerMove}
+      onPointerUp={onPointerEnd} onPointerCancel={onPointerEnd}>
+      <span className={css.title}>{t('branch.title')}</span>
+      <button type="button" className={css.delete} aria-label={t('branch.delete')} title={t('branch.delete')}
+        onClick={() => { remove(branch.id) }}>×</button>
+    </div>
+    <div className={css.body}>
+      <blockquote className={css.quote}>{branch.quote}</blockquote>
+      {branch.messages.map(message => <article key={`${message.seq}-${message.role}`}
+        className={message.role === 'user' ? css.userMessage : css.assistantMessage}>
+        {message.reasoning !== undefined && message.reasoning.trim() !== ''
+          && <BranchReasoning text={message.reasoning} live={message.live === true} labels={labels} t={t} />}
+        {message.text !== '' && <MarkdownText text={normalizeBranchMath(message.text)} streaming={message.live === true} labels={labels} />}
+      </article>)}
+      {branch.loading && <p className={css.status}>{t('branch.loading')}</p>}
+      {showWaiting && <p className={css.status}>{t('branch.waiting')}</p>}
+      {branch.error !== null && <p className={css.error} role="alert">{t('branch.error', { message: branch.error })}</p>}
+    </div>
+    <div className={css.composer}>
+      <textarea value={draft} onChange={event => { setDraft(event.target.value) }}
+        onKeyDown={event => { if (event.key === 'Enter' && !event.shiftKey) { event.preventDefault(); submit() } }}
+        placeholder={t('branch.placeholder')} aria-label={t('branch.placeholder')}
+        disabled={branch.loading || branch.running || branch.error !== null || branch.childId === undefined} rows={3} />
+      <div className={css.composerBottom}>
+        <div className={css.modelSeat}>{reference === undefined ? null : <SessionProvider session={reference}>
+          {renderSlot('branch.chat.model', { locked: branch.loading || branch.running })}
+        </SessionProvider>}</div>
+        <button type="button" onClick={submit} disabled={branch.loading || branch.running || branch.error !== null || draft.trim() === ''}
+          aria-label={t('branch.send')} className={css.send}>
+          <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden>
