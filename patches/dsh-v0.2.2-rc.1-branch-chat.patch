+/** Prepare model-authored display TeX for the shared Markdown renderer. */
+
+/** Put a display-math opener after prose on its own line, outside code fences. */
+export function normalizeBranchMath(text: string): string {
+  const lines = text.split('\n')
+  const output: string[] = []
+  let fence: { marker: string; size: number } | null = null
+  for (let index = 0; index < lines.length; index++) {
+    const line = lines[index]!
+    const marker = /^ {0,3}(`{3,}|~{3,})/u.exec(line)?.[1]
+    if (marker !== undefined) {
+      if (fence === null) fence = { marker: marker[0]!, size: marker.length }
+      else if (marker[0] === fence.marker && marker.length >= fence.size) fence = null
+      output.push(line)
+      continue
+    }
+    if (fence !== null || /^ {4}/u.test(line)) { output.push(line); continue }
+    const match = /^(.*\S[ \t]*)\\\[[ \t]*\r?$/u.exec(line)
+    const prefix = match?.[1]
+    if (prefix === undefined || prefix.endsWith('\\')) { output.push(line); continue }
+    let closed = false
+    for (let next = index + 1; next < lines.length; next++) {
+      const candidate = lines[next]!
+      if (/^[ \t]*\\\][ \t]*\r?$/u.test(candidate)) { closed = true; break }
+      if (/^ {0,3}(`{3,}|~{3,})/u.test(candidate)) break
+    }
+    if (!closed) { output.push(line); continue }
+    const returnChar = line.endsWith('\r') ? '\r' : ''
+    output.push(prefix.trimEnd() + returnChar, returnChar, '\\[' + returnChar)
+  }
+  return output.join('\n')
+}
