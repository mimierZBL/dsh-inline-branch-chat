diff --git a/packages/session/message-quotes/src/client/branch-chat.ts b/packages/session/message-quotes/src/client/branch-chat.ts
new file mode 100644
index 0000000..b0caac4
--- /dev/null
+++ b/packages/session/message-quotes/src/client/branch-chat.ts
@@ -0,0 +1,279 @@
+/** Local branch windows backed by ordinary forked Sessions and their event feed. */
+import type { ISessions, SessionEventLikeEntry, SessionReference } from '@deepseek-ai/dsh-api-session-controller/client'
+import { createSnapshotStore, type SnapshotStore } from '@deepseek-ai/dsh-client-store'
+import type { SessionEvent, SessionId } from '@deepseek-ai/dsh-session/types'
+
+declare module '@deepseek-ai/dsh-api-session-controller/client' {
+  interface SessionReferenceSourceMap {
+    /** A visible branch window owns this child's Client generation. */
+    branchChat: unknown
+  }
+}
+
+/** Viewport point used when a selection opens its window. */
+export interface BranchAnchor { readonly x: number; readonly y: number }
+
+/** One new message, excluding the inherited Session prefix. */
+export interface BranchMessage {
+  readonly seq: number
+  readonly role: 'user' | 'assistant'
+  readonly text: string
+  readonly reasoning?: string
+  readonly live?: boolean
+}
+
+/** One window in the local application. */
+export interface BranchWindow {
+  readonly id: string
+  readonly parentId: SessionId
+  readonly childId?: SessionId
+  readonly quote: string
+  readonly x: number
+  readonly y: number
+  readonly baselineSeq: number
+  readonly messages: readonly BranchMessage[]
+  readonly loading: boolean
+  readonly running: boolean
+  readonly error: string | null
+}
+
+/** Durable browser-local presentation data; model history lives in the child Session log. */
+interface SavedBranch {
+  id: string
+  parentId: SessionId
+  childId: SessionId
+  quote: string
+  x: number
+  y: number
+  baselineSeq: number
+}
+
+const STORAGE_KEY = 'dsh.branch-chat.windows.v1'
+
+function savedBranches(): SavedBranch[] {
+  if (typeof localStorage === 'undefined') return []
+  try {
+    const value: unknown = JSON.parse(localStorage.getItem(STORAGE_KEY) ?? '[]')
+    if (!Array.isArray(value)) return []
+    return value.filter((item): item is SavedBranch =>
+      typeof item === 'object' && item !== null
+      && typeof item.id === 'string' && typeof item.parentId === 'string'
+      && typeof item.childId === 'string' && typeof item.quote === 'string'
+      && typeof item.x === 'number' && typeof item.y === 'number'
+      && typeof item.baselineSeq === 'number')
+  } catch { return [] }
+}
+
+function visibleMessageText(event: SessionEvent, quote: string): BranchMessage | null {
+  if (event.type === 'user/message') {
+    if (event.data.source.kind !== 'user') return null
+    const text = event.data.content.flatMap(block => block.type === 'text' ? [block.text] : []).join('\n')
+    const prefix = `> ${quote.replaceAll('\n', '\n> ')}\n\n`
+    return { seq: event.seq, role: 'user', text: text.startsWith(prefix) ? text.slice(prefix.length) : text }
+  }
+  if (event.type === 'assistant/message') {
+    const text = event.data.message.content.flatMap(block => block.type === 'text' ? [block.text] : []).join('\n')
+    const reasoning = event.data.message.content.flatMap(block => block.type === 'reasoning' ? [block.text] : []).join('\n')
+    return text === '' && reasoning === '' ? null : { seq: event.seq, role: 'assistant', text, reasoning }
+  }
+  return null
+}
+
+/** Compose only actual model chunks; a settled Assistant event replaces these transient rows. */
+function branchMessages(entries: readonly SessionEventLikeEntry[], baselineSeq: number, quote: string): BranchMessage[] {
+  const messages: BranchMessage[] = []
+  const attempts = new Map<string, { seq: number; blocks: Map<number, { kind: 'text' | 'reasoning'; text: string }> }>()
+  for (const entry of entries) {
+    if (entry.event.seq <= baselineSeq) continue
+    if (entry.type === 'event') {
+      const message = visibleMessageText(entry.event, quote)
+      if (message !== null) messages.push(message)
+      continue
+    }
+    const { attemptId, chunk } = entry.event.data
+    const key = String(attemptId)
+    let attempt = attempts.get(key)
+    if (attempt === undefined) {
+      attempt = { seq: entry.event.seq, blocks: new Map() }
+      attempts.set(key, attempt)
+    }
+    attempt.seq = Math.max(attempt.seq, entry.event.seq)
+    if (chunk.type === 'reasoning-delta' || chunk.type === 'text-delta') {
+      const kind = chunk.type === 'reasoning-delta' ? 'reasoning' : 'text'
+      const previous = attempt.blocks.get(chunk.index)
+      attempt.blocks.set(chunk.index, { kind, text: (previous?.kind === kind ? previous.text : '') + chunk.text })
+    } else if (chunk.type === 'block-end' && (chunk.block.type === 'reasoning' || chunk.block.type === 'text')) {
+      attempt.blocks.set(chunk.index, { kind: chunk.block.type, text: chunk.block.text })
+    }
+  }
+  for (const attempt of attempts.values()) {
+    const blocks = [...attempt.blocks].sort(([left], [right]) => left - right).map(([, block]) => block)
+    const text = blocks.filter(block => block.kind === 'text').map(block => block.text).join('\n')
+    const reasoning = blocks.filter(block => block.kind === 'reasoning').map(block => block.text).join('\n')
+    if (text !== '' || reasoning !== '') messages.push({ seq: attempt.seq, role: 'assistant', text, reasoning, live: true })
+  }
+  return messages.sort((left, right) => left.seq - right.seq)
+}
+
+interface BranchRuntime {
+  readonly reference: SessionReference
+  disposeEvents: () => void
+  disposeSession: () => void
+}
+
+/** Own forked child lifetimes while their source conversation is selected. */
+export class BranchChatController {
+  readonly state: SnapshotStore<readonly BranchWindow[]>
+  private readonly runtimes = new Map<string, BranchRuntime>()
+  private readonly attaching = new Set<string>()
+  private readonly disposeList: () => void
+  private activeParent: SessionId | undefined
+  private disposed = false
+
+  /** @param sessions - existing Session service. */
+  constructor(private readonly sessions: ISessions) {
+    this.state = createSnapshotStore(savedBranches().map(saved => ({ ...saved, messages: [], loading: true, running: false, error: null })))
+    this.disposeList = sessions.list.subscribe(() => { this.syncActive() })
+    this.syncActive()
+  }
+
+  private publish(id: string, change: Partial<BranchWindow>): void {
+    this.state.set(this.state.getSnapshot().map(item => item.id === id ? { ...item, ...change } : item))
+  }
+
+  private persist(): void {
+    if (typeof localStorage === 'undefined') return
+    const saved = this.state.getSnapshot().flatMap((item): SavedBranch[] => item.childId === undefined ? [] : [{
+      id: item.id, parentId: item.parentId, childId: item.childId, quote: item.quote,
+      x: item.x, y: item.y, baselineSeq: item.baselineSeq,
+    }])
+    localStorage.setItem(STORAGE_KEY, JSON.stringify(saved))
+  }
+
+  private syncActive(): void {
+    const next = Object.values(this.sessions.list.getSnapshot().byId)
+      .find(row => (row.retainedBy.mainView ?? 0) > 0)?.id
+    if (next !== this.activeParent) {
+      this.activeParent = next
+      for (const id of this.runtimes.keys()) this.detach(id)
+    }
+    if (next === undefined) return
+    for (const item of this.state.getSnapshot()) {
+      if (item.parentId === next && item.childId !== undefined && !this.runtimes.has(item.id)) this.attach(item)
+    }
+  }
+
+  private attach(item: BranchWindow): void {
+    if (item.childId === undefined || this.disposed || this.attaching.has(item.id)) return
+    this.attaching.add(item.id)
+    let reference: SessionReference
+    try { reference = this.sessions.retain(item.childId, { source: 'branchChat' }) }
+    catch (error) {
+      this.publish(item.id, { loading: false, error: String(error) })
+      return
+    } finally { this.attaching.delete(item.id) }
+    const runtime: BranchRuntime = { reference, disposeEvents: () => {}, disposeSession: () => {} }
+    this.runtimes.set(item.id, runtime)
+    void reference.ready.then(() => {
+      if (this.runtimes.get(item.id) !== runtime) return
+      const source = reference.binding.eventSource
+      const refresh = (): void => {
+        const entries = source.getSnapshot().entries
+        const current = this.state.getSnapshot().find(row => row.id === item.id)
+        if (current === undefined) return
+        const session = reference.binding.session.getSnapshot()
+        if (session.openState === 'error') {
+          this.publish(item.id, { loading: false, error: String(session.openError) })
+          return
+        }
+        const baselineSeq = current.baselineSeq < 0
+          ? entries.reduce((last, entry) => Math.max(last, entry.event.seq), 0) : current.baselineSeq
+        const messages = branchMessages(entries, baselineSeq, current.quote)
+        this.publish(item.id, { baselineSeq, messages, loading: false })
+        if (current.baselineSeq < 0) this.persist()
+      }
+      runtime.disposeEvents = source.subscribe(refresh)
+      runtime.disposeSession = reference.binding.session.subscribe(() => {
+        this.publish(item.id, { running: reference.binding.session.getSnapshot().running })
+      })
+      refresh()
+      this.publish(item.id, { running: reference.binding.session.getSnapshot().running })
+    }, error => {
+      if (this.runtimes.get(item.id) === runtime) this.publish(item.id, { loading: false, error: String(error) })
+    })
+  }
+
+  private detach(id: string): void {
+    const runtime = this.runtimes.get(id)
+    if (runtime === undefined) return
+    this.runtimes.delete(id)
+    runtime.disposeEvents()
+    runtime.disposeSession()
+    runtime.reference.release()
+  }
+
+  /** Give the existing per-session model selector the branch's retained binding. */
+  referenceFor(id: string): SessionReference | undefined { return this.runtimes.get(id)?.reference }
+
+  /** Create a child Session with the current completed conversation prefix. */
+  create(parentId: SessionId, quote: string, anchor: BranchAnchor): void {
+    const id = crypto.randomUUID()
+    const width = Math.min(420, window.innerWidth - 24, window.innerHeight * 0.65)
+    const height = Math.min(700, window.innerHeight - 24)
+    const x = Math.max(12, Math.min(anchor.x + 18, window.innerWidth - width - 12))
+    const y = Math.max(12, Math.min(anchor.y - 18, window.innerHeight - height - 12))
+    this.state.set([...this.state.getSnapshot(), {
+      id, parentId, quote, x, y, baselineSeq: -1, messages: [], loading: true, running: false, error: null,
+    }])
+    void this.sessions.fork({ sessionId: parentId }).then(childId => {
+      // This marker is read by the Workspace tree before a child can become a sidebar row.
+      try {
+        localStorage.setItem(`dsh.branch-chat.hidden.${childId}`, '1')
+      } catch (error) {
+        this.publish(id, { loading: false, error: String(error) })
+        return
+      }
+      if (this.disposed || !this.state.getSnapshot().some(row => row.id === id)) return
+      this.publish(id, { childId })
+      this.persist()
+      this.syncActive()
+      const branch = this.state.getSnapshot().find(row => row.id === id)
+      if (branch !== undefined && !this.runtimes.has(id)) this.attach(branch)
+    }, error => { this.publish(id, { loading: false, error: String(error) }) })
+  }
+
+  /** Send a follow-up to the copied Session without writing to its parent. */
+  async send(id: string, question: string): Promise<void> {
+    const item = this.state.getSnapshot().find(row => row.id === id)
+    const runtime = this.runtimes.get(id)
+    if (item === undefined || runtime === undefined || question.trim() === '') return
+    this.publish(id, { error: null, running: true })
+    const quoted = `> ${item.quote.replaceAll('\n', '\n> ')}\n\n${question.trim()}`
+    try {
+      const result = await runtime.reference.binding.session.prompt([{ type: 'text', text: quoted }], 'queue')
+      if (!result.ok) this.publish(id, { running: false, error: result.error.message })
+    } catch (error) {
+      this.publish(id, { running: false, error: String(error) })
+    }
+  }
+
+  /** Remember a dragged viewport location. */
+  move(id: string, anchor: BranchAnchor): void {
+    this.publish(id, anchor)
+    this.persist()
+  }
+
+  /** Remove the window; child logs stay hidden and untouched. */
+  remove(id: string): void {
+    this.detach(id)
+    this.state.set(this.state.getSnapshot().filter(row => row.id !== id))
+    this.persist()
+  }
+
+  /** Release all active child references and subscriptions. */
+  dispose(): void {
+    this.disposed = true
+    this.disposeList()
+    for (const id of this.runtimes.keys()) this.detach(id)
+  }
+}
