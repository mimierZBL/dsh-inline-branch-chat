index 0000000..a0a412a
--- /dev/null
+++ b/packages/session/message-quotes/tests/branch-math.client.spec.ts
@@ -0,0 +1,14 @@
+import { describe, expect, it } from 'vitest'
+import { normalizeBranchMath } from '../src/client/branch-math.ts'
+
+describe('branch answer math display', () => {
+  it('moves inline display-math openers onto their own line without changing formulas', () => {
+    const reply = '阳极（氧化）：\\[\n2\\mathrm{Cl^-}\\rightarrow\\mathrm{Cl_2}\n\\]\n分数：\\[\n\\frac{1}{2}\n\\]'
+    expect(normalizeBranchMath(reply)).toBe('阳极（氧化）：\n\n\\[\n2\\mathrm{Cl^-}\\rightarrow\\mathrm{Cl_2}\n\\]\n分数：\n\n\\[\n\\frac{1}{2}\n\\]')
+  })
+
+  it('leaves prose slashes, code fences, escaped markers and incomplete math alone', () => {
+    const reply = 'x/y\n\n```tex\n阳极：\\[\n\\frac{1}{2}\n\\]\n```\n\nEscaped \\\\[\n\n阳极：\\[\nno close'
+    expect(normalizeBranchMath(reply)).toBe(reply)
+  })
+})
